{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": null,
  "installCommand": "npm ci",
  "rewrites": [
    {
      "source": "/robots.txt",
      "destination": "https://wps-ranking-2aqr.vercel.app/seo/robots.txt"
    },
    {
      "source": "/sitemap.xml",
      "destination": "https://wps-ranking-2aqr.vercel.app/seo/sitemap.xml"
    },
    {
      "source": "/sitemaps/:file",
      "destination": "https://wps-ranking-2aqr.vercel.app/seo/sitemaps/:file"
    },
    {
      "source": "/profile/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(Googlebot|Google-InspectionTool|GoogleOther|bingbot|BingPreview|YandexBot|YandexRenderResourcesBot|DuckDuckBot|Baiduspider|Applebot|TelegramBot|Discordbot|Twitterbot|facebookexternalhit|LinkedInBot|Slackbot|WhatsApp|redditbot).*"
        }
      ],
      "destination": "https://wps-ranking-2aqr.vercel.app/seo/profile/:id"
    },
    {
      "source": "/leaderboard",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(Googlebot|Google-InspectionTool|GoogleOther|bingbot|BingPreview|YandexBot|YandexRenderResourcesBot|DuckDuckBot|Baiduspider|Applebot|TelegramBot|Discordbot|Twitterbot|facebookexternalhit|LinkedInBot|Slackbot|WhatsApp|redditbot).*"
        }
      ],
      "destination": "https://wps-ranking-2aqr.vercel.app/seo/leaderboard"
    },
    {
      "source": "/countries",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(Googlebot|Google-InspectionTool|GoogleOther|bingbot|BingPreview|YandexBot|YandexRenderResourcesBot|DuckDuckBot|Baiduspider|Applebot|TelegramBot|Discordbot|Twitterbot|facebookexternalhit|LinkedInBot|Slackbot|WhatsApp|redditbot).*"
        }
      ],
      "destination": "https://wps-ranking-2aqr.vercel.app/seo/countries"
    },
    {
      "source": "/leaderboard",
      "destination": "/index.html"
    },
    {
      "source": "/profile/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/compare",
      "destination": "/index.html"
    },
    {
      "source": "/about",
      "destination": "/index.html"
    },
    {
      "source": "/search",
      "destination": "/index.html"
    },
    {
      "source": "/countries",
      "destination": "/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
