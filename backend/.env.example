## API (Vercel project env / local dev)
# Supabase transaction pooler (port 6543) for serverless:
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
# Local: postgresql://postgres:postgres@localhost:5432/wps
DATABASE_URL=
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Public base URL of this API (used in share/OG links), e.g. https://wps-ranking-api.vercel.app
SITE_URL=
# Frontend URL that share links redirect people to
FRONTEND_URL=
PORT=5000

## Pipeline (GitHub Actions secret PIPELINE_DATABASE_URL / local runs)
# Needs a session-level connection: Supabase *session* pooler (port 5432) or direct connection.
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Falls back to DATABASE_URL when unset.
PIPELINE_DATABASE_URL=
